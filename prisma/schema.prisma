// Prisma Schema for LifeOS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String
  profileImage String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  categories   Category[]
  events       Event[]
  memories     Memory[]
  goals        Goal[]
  documents    Document[]
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#6366f1")
  icon      String   @default("tag")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    Event[]
}

model Event {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String?
  title       String
  description String?
  eventDate   DateTime
  location    String?
  importance  String   @default("Normal")
  visibility  String   @default("Private")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Memory {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  memoryDate  DateTime
  location    String?
  imageUrl    String?
  tags        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id           String    @id @default(uuid())
  userId       String
  title        String
  description  String?
  startDate    DateTime?
  targetDate   DateTime?
  progress     Int       @default(0)
  currentValue Int       @default(0)
  targetValue  Int       @default(100)
  unit         String?
  priority     String    @default("Medium") // Low, Medium, High
  status       String    @default("Not Started") // Not Started, In Progress, Completed, Archived
  category     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileType    String
  fileSize    Int
  categoryId  String?
  category    String?  @default("Other")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
